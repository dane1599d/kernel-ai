#!/usr/bin/env bash
# Stub gh for the batcher tests (run.sh): answers only the calls the batcher
# makes, from a PR table $T/prs/<n>/{state,sha,branch,base,files,cross,labels}.
# A PR whose head is in the bare repo's main reads as MERGED. CI and fluency are
# always green. $T/kill-on-ready and $T/kill-on-merged kill the batch-ff.sh in
# $T/ffpid once, at `gh pr ready` (before the fast-forward) or at the first
# MERGED answer (after it), as a PC stop would; $T/list-fails fails the
# open-PR listing. While the batch branch holds every head on a line of
# $T/fail-with, CI fails and its log is $T/compile.log (a batch that does not
# compile; two heads on a line are two PRs that clash only together).
T=${STUB_T:?}
echo "gh $*" >> "$T/gh.log"
a="$*"
pr() { cat "$T/prs/$1/$2" 2>/dev/null; }
compile_fails() {
  local b line s all
  [ -f "$T/fail-with" ] || return 1
  for b in $(git -C "$T/origin.git" for-each-ref --format='%(refname)' refs/heads/batch/); do
    while read -r line; do
      all=1
      for s in $line; do
        git -C "$T/origin.git" merge-base --is-ancestor "$s" "$b" 2>/dev/null || all=""
      done
      [ -n "$all" ] && return 0
    done < "$T/fail-with"
  done
  return 1
}
[ "$1 $2" = "run view" ] && compile_fails && CI_RESULT=failure
st() {
  local s
  s=$(pr $1 state)
  if [ "$s" = OPEN ] && git -C "$T/origin.git" merge-base --is-ancestor "$(pr $1 sha)" refs/heads/main 2>/dev/null; then s=MERGED; fi
  if [ "$s" = MERGED ] && [ -f "$T/kill-on-merged" ]; then rm -f "$T/kill-on-merged"; kill -9 $(cat "$T/ffpid"); fi
  echo $s
}
if [ "$1 $2" = "pr ready" ] && [ -f "$T/kill-on-ready" ]; then rm -f "$T/kill-on-ready"; kill -9 $(cat "$T/ffpid"); exit 1; fi
case "$1 $2" in
  "pr view")
    n=$3
    case "$a" in
      *"--json labels"*) pr $n labels;;
      *"state,isCrossRepository"*) echo "$(st $n) $(pr $n cross || echo false)";;
      *"--json state"*) st $n;;
      *"--json headRefName"*) pr $n branch;;
      *"--json baseRefName"*) pr $n base;;
      *"--json headRefOid"*) git -C "$T/origin.git" rev-parse --verify -q "refs/heads/$(pr $n branch)" || pr $n sha;;
    esac;;
  "pr diff") pr $3 files;;
  "pr create") echo "https://github.com/x/y/pull/999";;
  "pr list")
    case "$a" in
      *"--head"*) echo 999;;
      *"number,headRefName,headRefOid,labels"*)
        for d in "$T"/prs/*; do n=$(basename "$d"); [ "$(st $n)" = OPEN ] || continue
          h=$(git -C "$T/origin.git" rev-parse --verify -q "refs/heads/$(pr $n branch)" || pr $n sha)
          r=false; grep -qx batch-ready "$d/labels" && r=true
          f=false; grep -qx batch-first "$d/labels" && f=true
          echo "$n $(pr $n branch) $h $r $f"; done;;
      *"number,headRefOid"*)
        for d in "$T"/prs/*; do n=$(basename "$d"); [ "$(st $n)" = OPEN ] || continue
          echo "$n $(git -C "$T/origin.git" rev-parse --verify -q "refs/heads/$(pr $n branch)" || pr $n sha)"; done;;
      *"baseRefName,headRefName"*)
        [ -f "$T/list-fails" ] && exit 1
        for d in "$T"/prs/*; do n=$(basename "$d"); [ "$(st $n)" = OPEN ] && { pr $n base; pr $n branch; }; done; true;;
    esac;;
  "pr edit") case "$a" in *"--remove-label batch-ready"*) : > "$T/prs/$3/labels";; esac;;
  "pr ready"|"pr close"|"pr comment"|"run cancel"|"run rerun") :;;
  "run list")
    case "$a" in
      *ci.yml*) echo "123 completed";;
      *fluency-model*) echo "456 completed";;
      # cleanup's listing of the batch branch's unfinished runs.
      *"--limit 10"*) echo 789;;
      *"--limit 30"*)
        [ -f "$T/others-fail" ] && exit 1
        if [ -f "$T/others" ]; then cat "$T/others"; else echo "DCO=success"; fi;;
    esac;;
  "run view")
    case "$a" in
      *--log-failed*) if compile_fails; then cat "$T/compile.log"; else cat "$T/failed.log" 2>/dev/null; fi;;
      *--log*) cat "$T/fluency.log";;
      # CI_SKIP_BOOT: the boot jobs skipped, as CI skips them for a no-boot batch.
      *) for j in "Format, lint" "Boot test (kvm, shard 1)" "Boot test (kvm, shard 2)" "Boot test (kvm, shard 3)" "Boot test (tcg, shard 1)" "Boot test (tcg, shard 2)" "Boot test (tcg, shard 3)" "Boot test (tcg, shard 4)" "Observe determinism 1" "Observe determinism 2" "Observe determinism 3"; do
           r=${CI_RESULT:-success}; [ -n "${CI_SKIP_BOOT:-}" ] && [ "$j" != "Format, lint" ] && r=skipped; echo "$j=$r"; done;;
    esac;;
  "workflow run") echo dispatched >> "$T/fluency-dispatches";;
  *) echo "stub gh: unhandled $a" >&2; exit 1;;
esac
