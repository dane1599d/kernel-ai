/// The part of `kai:ui/app@0.1.0` that Notes' window binds itself; `compsdk` and
/// `comp-notes` bind `kai:app/component` and `app:notes/actions`.
package app:notes-window@1.0.0;

world window-only {
    import kai:ui/view@0.1.1;
    export kai:ui/input@0.1.1;
}

/// The app, as its manifest names it: a live component with Notes' actions and
/// its window.
world notes-window {
    include kai:app/component@0.1.0;
    // Its notes, one key each (P4 task 6).
    import kai:app/storage@0.1.0;
    import kai:ui/view@0.1.1;
    export kai:ui/input@0.1.1;
    export app:notes/actions@1.0.0;
}
