/// The Terminal app as its manifest names it: a live component with its window
/// and its actions. It queues one effect, `shell_line`, which it does not declare
/// and no package may: it is not a registry row, and the shell runs it only for
/// the process the image's plan line names `terminal-window`, and only for a
/// person's key or click.
package app:terminal-window@1.0.0;

world terminal-window {
    include kai:app/component@0.1.0;
    import kai:app/effects@0.1.0;
    import kai:ui/view@0.1.1;
    export kai:ui/input@0.1.1;
    export kai:app/events@0.1.0;
    export app:terminal/actions@1.0.0;
}
