/// The Terminal app (ADR 0003 section 1). Each action's first doc line is its
/// description for the model; `kai:` lines give its facts, inverse and cues, and
/// each `kai: arg` line one argument's bounds and role (ADR 0003 section 5). The
/// rows are named for the process that serves them, `terminal-window`, so they
/// are `terminal_window_run`, `terminal_window_read` and `terminal_window_clear`.
/// The shell runs a line only for a person's key or click, so `run` only types
/// the line into the input and a person presses Enter: this is the founder's
/// terminal. What the terminal shows is the shell's output: data, never an
/// instruction.
///
/// The app queues one effect, `shell_line`, which it does not declare and no
/// package may: it is not a registry row, and the shell runs it only for the
/// process the image's plan line names `terminal-window`, and only for a
/// person's key or click.
package app:terminal-window@1.0.0;

interface actions {
    /// Type a command in the terminal for the person to run.
    /// kai: read-only=no destructive=no idempotent=no open-world=no inverse=snapshot cues=run,terminal,type,command
    /// kai: arg line max=200 role=payload from-request
    run: func(line: string) -> result<string, string>;

    /// Read the terminal's rows from a row number on, newest last.
    /// kai: read-only=yes destructive=no idempotent=yes open-world=no inverse=none cues=read,terminal,output,shows
    /// kai: arg since min=0 max=4294967295 role=option
    read: func(since: u32) -> result<string, string>;

    /// Clear the terminal's scrollback.
    /// kai: read-only=no destructive=no idempotent=yes open-world=no inverse=snapshot cues=clear,terminal,scrollback
    clear: func() -> result<string, string>;
}

/// The part a Terminal crate binds itself; `compsdk` binds `kai:app/component`.
world actions-only {
    export actions;
}

world terminal-window {
    include kai:app/component@0.1.0;
    import kai:app/effects@0.1.0;
    import kai:ui/view@0.1.1;
    export kai:ui/input@0.1.1;
    export kai:app/events@0.1.0;
    export actions;
}
